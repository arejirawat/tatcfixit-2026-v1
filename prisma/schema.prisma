generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("STAFF") // "ADMIN" or "STAFF"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  citizenId String   @unique // รหัสบัตรประชาชน
  name      String   // ชื่อ-นามสกุล
  address   String?  // ที่อยู่
  phone     String?  // เบอร์โทร
  jobs      Job[]
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique // เช่น พัดลม, เตารีด
  jobs      Job[]
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Job {
  id           Int      @id @default(autoincrement())
  jobId        String   @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   Int
  itemDetail   String   // รายละเอียดสิ่งของ
  symptoms     String   // อาการเสีย
  repairNotes  String?  // ผลการซ่อม/รายละเอียดการซ่อม
  status       String   @default("PENDING") // PENDING, REPAIRING, WAITING_RETURN, RETURNED
  isSynced     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key   String @id // e.g., "QUEUE_PREFIX", "QUEUE_NUMBER"
  value String
}
