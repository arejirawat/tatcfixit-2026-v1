generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("STAFF") // "ADMIN" or "STAFF"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  citizenId String   @unique // รหัสบัตรประชาชน
  name      String   // ชื่อ-นามสกุล
  address   String?  // ที่อยู่
  phone     String?  // เบอร์โทร
  jobs      Job[]
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique // เช่น พัดลม, เตารีด
  jobs      Job[]
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Job {
  id           Int      @id @default(autoincrement())
  jobId        String   @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   Int
  itemDetail   String   // รายละเอียดสิ่งของ
  symptoms     String   // อาการเสีย
  repairNotes  String?  // ผลการซ่อม/รายละเอียดการซ่อม
  repairerName String?  // ชื่อช่างผู้ซ่อม
  status       String   @default("PENDING") // PENDING, REPAIRING, WAITING_RETURN, RETURNED
  // ข้อมูลสำหรับส่ง OVEC V-Care (v1.2.0)
  serviceType     String?   // รหัสประเภทบริการ V-Care: APPLIANCE, MOTORCYCLE, CAR, TOOL, HOME_ELEC
  brandModel      String?   // ยี่ห้อ / รุ่น
  licensePlate    String?   // ทะเบียนรถ / จังหวัด (งานรถ)
  partsUsed       String?   // อะไหล่ที่เปลี่ยน
  partsCost       Float?    // ค่าใช้จ่าย (บาท)
  vcareExportedAt DateTime? // วันที่ส่งออกไป V-Care แล้ว (null = ยังไม่ส่ง)
  isSynced     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key   String @id // e.g., "QUEUE_PREFIX", "QUEUE_NUMBER"
  value String
}
